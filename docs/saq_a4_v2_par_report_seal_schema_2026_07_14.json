{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ufowoqqqo/SAQ/blob/saq-arbitrary-cardinality-feasibility-v2/docs/saq_a4_v2_par_report_seal_schema_2026_07_14.json",
  "title": "A4 V2 PAR seal schema after PAR-report timing-closure erratum",
  "$comment": "The canonical maximal instance registered by the composite protocol authority supplies the exact byte ceiling M. Runtime also requires M <= 65536. Cross-record hash, identity, aggregate, and Git-DAG invariants are normative in the erratum contract.",
  "$ref": "#/$defs/par_seal",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uint64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "utc_microseconds": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "document_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"$ref": "#/$defs/uint64"}
      }
    },
    "phase_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv_sha256", "attempt_id", "binary_sha256", "completed_unit_index", "cpu_microseconds", "end_utc", "environment_sha256", "execution_commit", "exit_reason", "logical_run_id", "peak_rss_bytes", "phase", "staging_disposition", "start_utc", "wall_nanoseconds"],
      "properties": {
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "attempt_id": {"type": "integer", "minimum": 0, "maximum": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "completed_unit_index": {"const": -1},
        "cpu_microseconds": {"type": "integer", "minimum": 0, "maximum": 86400000000},
        "end_utc": {"$ref": "#/$defs/utc_microseconds"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "execution_commit": {"$ref": "#/$defs/git_oid"},
        "exit_reason": {"oneOf": [{"const": "PHASE_COMPLETE"}, {"type": "string", "pattern": "^EXTERNAL_SIGNAL_([1-9]|[1-5][0-9]|6[0-4])$"}]},
        "logical_run_id": {"$ref": "#/$defs/sha256"},
        "peak_rss_bytes": {"$ref": "#/$defs/uint64"},
        "phase": {"enum": ["B_build", "P_parity"]},
        "staging_disposition": {"enum": ["DISCARDED", "NONE"]},
        "start_utc": {"$ref": "#/$defs/utc_microseconds"},
        "wall_nanoseconds": {"type": "integer", "minimum": 0, "maximum": 172800000000000}
      },
      "allOf": [
        {
          "if": {"properties": {"exit_reason": {"const": "PHASE_COMPLETE"}}, "required": ["exit_reason"]},
          "then": {"properties": {"staging_disposition": {"const": "NONE"}}}
        },
        {
          "if": {"properties": {"exit_reason": {"pattern": "^EXTERNAL_SIGNAL_"}}, "required": ["exit_reason"]},
          "then": {"properties": {"staging_disposition": {"const": "DISCARDED"}}}
        }
      ]
    },
    "b0_complete": {"allOf": [{"$ref": "#/$defs/phase_receipt"}, {"properties": {"attempt_id": {"const": 0}, "exit_reason": {"const": "PHASE_COMPLETE"}, "phase": {"const": "B_build"}, "staging_disposition": {"const": "NONE"}}}]},
    "b0_interrupted": {"allOf": [{"$ref": "#/$defs/phase_receipt"}, {"properties": {"attempt_id": {"const": 0}, "exit_reason": {"pattern": "^EXTERNAL_SIGNAL_([1-9]|[1-5][0-9]|6[0-4])$"}, "phase": {"const": "B_build"}, "staging_disposition": {"const": "DISCARDED"}}}]},
    "b1_complete": {"allOf": [{"$ref": "#/$defs/phase_receipt"}, {"properties": {"attempt_id": {"const": 1}, "exit_reason": {"const": "PHASE_COMPLETE"}, "phase": {"const": "B_build"}, "staging_disposition": {"const": "NONE"}}}]},
    "p0_complete": {"allOf": [{"$ref": "#/$defs/phase_receipt"}, {"properties": {"attempt_id": {"const": 0}, "exit_reason": {"const": "PHASE_COMPLETE"}, "phase": {"const": "P_parity"}, "staging_disposition": {"const": "NONE"}}}]},
    "p0_interrupted": {"allOf": [{"$ref": "#/$defs/phase_receipt"}, {"properties": {"attempt_id": {"const": 0}, "exit_reason": {"pattern": "^EXTERNAL_SIGNAL_([1-9]|[1-5][0-9]|6[0-4])$"}, "phase": {"const": "P_parity"}, "staging_disposition": {"const": "DISCARDED"}}}]},
    "p1_complete": {"allOf": [{"$ref": "#/$defs/phase_receipt"}, {"properties": {"attempt_id": {"const": 1}, "exit_reason": {"const": "PHASE_COMPLETE"}, "phase": {"const": "P_parity"}, "staging_disposition": {"const": "NONE"}}}]},
    "receipt_sequence": {
      "oneOf": [
        {"type": "array", "prefixItems": [{"$ref": "#/$defs/b0_complete"}, {"$ref": "#/$defs/p0_complete"}], "items": false, "minItems": 2, "maxItems": 2},
        {"type": "array", "prefixItems": [{"$ref": "#/$defs/b0_interrupted"}, {"$ref": "#/$defs/b1_complete"}, {"$ref": "#/$defs/p0_complete"}], "items": false, "minItems": 3, "maxItems": 3},
        {"type": "array", "prefixItems": [{"$ref": "#/$defs/b0_complete"}, {"$ref": "#/$defs/p0_interrupted"}, {"$ref": "#/$defs/p1_complete"}], "items": false, "minItems": 3, "maxItems": 3},
        {"type": "array", "prefixItems": [{"$ref": "#/$defs/b0_interrupted"}, {"$ref": "#/$defs/b1_complete"}, {"$ref": "#/$defs/p0_interrupted"}, {"$ref": "#/$defs/p1_complete"}], "items": false, "minItems": 4, "maxItems": 4}
      ]
    },
    "phase_byte_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_temporary_bytes", "deleted_partial_bytes", "maximum_live_owned_temporary_bytes", "permanent_intermediate_bundle_bytes", "phase", "research_evidence_archive_bytes"],
      "properties": {
        "created_temporary_bytes": {"$ref": "#/$defs/uint64"},
        "deleted_partial_bytes": {"$ref": "#/$defs/uint64"},
        "maximum_live_owned_temporary_bytes": {"$ref": "#/$defs/uint64"},
        "permanent_intermediate_bundle_bytes": {"$ref": "#/$defs/uint64"},
        "phase": {"enum": ["B_build", "P_parity"]},
        "research_evidence_archive_bytes": {"$ref": "#/$defs/uint64"}
      }
    },
    "phase_byte_ledger": {
      "type": "array",
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/phase_byte_entry"}, {"properties": {"phase": {"const": "B_build"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase_byte_entry"}, {"properties": {"phase": {"const": "P_parity"}}}]}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "par_seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_index", "artifact_kind", "build_manifest", "implementation_commit", "parity_pass", "parity_summary", "phase_byte_ledger", "phase_receipts", "producer_native", "protocol", "schema", "schema_version", "source_manifest", "source_tree_sha256", "verifier_native"],
      "properties": {
        "artifact_index": {"allOf": [{"$ref": "#/$defs/document_identity"}, {"properties": {"path": {"const": "docs/saq_a4_v2_par_artifacts_2026_07_14/artifact_index.json"}}}]},
        "artifact_kind": {"const": "a4_v2_par_seal"},
        "build_manifest": {"allOf": [{"$ref": "#/$defs/document_identity"}, {"properties": {"path": {"const": "docs/saq_a4_v2_par_artifacts_2026_07_14/build_manifest.json"}}}]},
        "implementation_commit": {"$ref": "#/$defs/git_oid"},
        "parity_pass": {"const": true},
        "parity_summary": {"allOf": [{"$ref": "#/$defs/document_identity"}, {"properties": {"path": {"const": "docs/saq_a4_v2_par_artifacts_2026_07_14/parity_summary.json"}}}]},
        "phase_byte_ledger": {"$ref": "#/$defs/phase_byte_ledger"},
        "phase_receipts": {"$ref": "#/$defs/receipt_sequence"},
        "producer_native": {"allOf": [{"$ref": "#/$defs/document_identity"}, {"properties": {"path": {"const": "build/a4_v2/a4_v2_native"}}}]},
        "protocol": {"allOf": [{"$ref": "#/$defs/document_identity"}, {"properties": {"path": {"const": "docs/saq_a4_v2_protocol_authority_manifest_2026_07_14.json"}}}]},
        "schema": {"allOf": [{"$ref": "#/$defs/document_identity"}, {"properties": {"path": {"const": "docs/saq_a4_v2_artifact_schema_2026_07_14.json"}}}]},
        "schema_version": {"const": 1},
        "source_manifest": {"allOf": [{"$ref": "#/$defs/document_identity"}, {"properties": {"path": {"const": "docs/saq_a4_v2_implementation_manifest_2026_07_14.json"}}}]},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "verifier_native": {"allOf": [{"$ref": "#/$defs/document_identity"}, {"properties": {"path": {"const": "build/a4_v2_verifier/a4_v2_native"}}}]}
      }
    }
  }
}
